{
  "name": "nono-skills",
  "version": "0.14.0",
  "description": "Reusable engineering skills and bounded review-fix loops for Codex and other Agent Skills hosts.",
  "author": "thitikorn.j",
  "type": "module",
  "bin": {
    "nono-skills": "bin/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "eval:skills": "node scripts/eval-skills.mjs",
    "eval:host": "node scripts/eval-host.mjs validate",
    "sync:portable": "node scripts/sync-portable-resources.mjs",
    "validate": "node scripts/validate.mjs",
    "prepublishOnly": "npm test && npm run validate && npm run eval:skills && npm run eval:host"
  },
  "files": [
    "bin/",
    "src/",
    "plugin/",
    "templates/",
    "scripts/",
    "evals/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "agent-skills",
    "ai-coding-agent",
    "software-engineering",
    "developer-tools",
    "code-review",
    "bug-fix",
    "qa-testing",
    "security-review",
    "engineering-loop",
    "review-fix-loop",
    "agent-evaluation",
    "multi-agent",
    "agent-orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nono911/nono-skills.git"
  },
  "homepage": "https://github.com/nono911/nono-skills#readme",
  "bugs": {
    "url": "https://github.com/nono911/nono-skills/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
